VNPAY_RETURN_URL=http://127.0.0.1:8000/api/payment/vnpay/return

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# auto | gemini | ollama | rules
AI_ENGINE=auto

# Ollama (chạy local, miễn phí)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Gemini (tùy chọn) - lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- AI Fashion Trend Detection ----
TREND_ENABLED=true
TREND_COUNTRY=VN
TREND_CACHE_TTL=21600
TREND_LIMIT=10
TREND_PRODUCT_LIMIT=8
TREND_SOURCE=auto
TREND_REFRESH_TIMEOUT=12.0
TREND_RISING_THRESHOLD=20.0
TREND_DECLINING_THRESHOLD=-20.0
