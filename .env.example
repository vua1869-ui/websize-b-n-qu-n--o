# Sao chép file này thành ".env" rồi chỉnh sửa. KHÔNG commit file .env.
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=https://aurastudio.vn # Domain chính thức của hệ thống (bắt buộc khi production)
APP_ENV=dev              # dev | production (khi chọn production, bắt buộc phải thay đổi secret & CSDL)
DEBUG=false              # Mặc định False để đảm bảo an toàn

# BẮT BỘC ĐỔI khi triển khai sản xuất (dùng lệnh: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai
PAYMENT_WEBHOOK_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat-webhook-vnpay

# CSDL (Mặc định SQLite, chuyển sang PostgreSQL khi production)
# DATABASE_URL=postgresql://user:password@localhost:5432/aura_db

# ---- Cổng thanh toán VNPay ----
# Lấy tại VNPay Merchant Portal (sandbox dùng được ngay, xem tài liệu VNPay tại vnpay.vn)
# Thông tin test sandbox: https://sandbox.vnpayment.vn/apis/docs/thanh-toan-pay/pay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:8000/api/payment/vnpay/return

# ---- Cloudinary Image Storage ----
# Lấy tại cloudinary.com/console → Settings → Access Keys
# CẢNH BÁO: nếu đây là tài khoản Cloudinary thật và key đã từng bị commit,
# hãy vào Cloudinary Console → Settings → Access Keys → Regenerate ngay!
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# auto | gemini | ollama | rules
AI_ENGINE=auto

# Ollama (chạy local, miễn phí)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Gemini (tùy chọn) - lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- AI Fashion Trend Detection ----
TREND_ENABLED=true
TREND_COUNTRY=VN
TREND_CACHE_TTL=21600
TREND_LIMIT=10
TREND_PRODUCT_LIMIT=8
TREND_SOURCE=auto
TREND_REFRESH_TIMEOUT=12.0
TREND_RISING_THRESHOLD=20.0
TREND_DECLINING_THRESHOLD=-20.0

# ---- Email Sender ----
# console | smtp | resend
EMAIL_BACKEND=console
EMAIL_FROM="AURA Studio <no-reply@aurastudio.vn>"

# SMTP (khi dùng EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_TLS=true

# Resend API (khi dùng EMAIL_BACKEND=resend)
RESEND_API_KEY=re_123456789

# ---- Hardening & Reverse Proxy ----
TRUSTED_PROXY_HEADERS=false # Chỉ bật (true) khi server đứng sau reverse proxy tin cậy (Nginx/Cloudflare)
LOG_LEVEL=INFO

# ---- AI Stylist Concurrency & Prompt Limit ----
AI_PROMPT_MAX_PRODUCTS=30   # Giới hạn số sản phẩm gửi kèm trong system prompt
AI_MAX_CONCURRENCY=4        # Giới hạn số request AI chạy đồng thời trước khi fallback rules
TREND_ANCHOR_KEYWORD="thời trang"

# ---- Social Proof & Demo Data ----
DEMO_DATA=false             # Khi false, chỉ hiển thị đánh giá và số liệu thực tế từ khách hàng

# ---- Loyalty Points & Tiers ----
LOYALTY_EARN_RATE_SILVER=0.03   # 3% tích điểm cho hạng Bạc
LOYALTY_EARN_RATE_GOLD=0.05     # 5% tích điểm cho hạng Vàng
LOYALTY_EARN_RATE_DIAMOND=0.08  # 8% tích điểm cho hạng Kim Cương

# ---- Invoice & Seller Info (Xuất hóa đơn & Thông tin pháp lý) ----
SELLER_NAME="CÔNG TY TNHH THỜI TRANG AURA STUDIO"
SELLER_TAX_CODE="0317894562"
SELLER_ADDRESS="Tầng 5, Tòa nhà AURA, 123 Đường Nguyễn Trãi, Quận 1, TP. Hồ Chí Minh"
SELLER_HOTLINE="1900 6868"
VAT_RATE=8
E_INVOICE_PROVIDER=""

# ---- Bank Transfer Info (Chuyển khoản VietQR) ----
BANK_ID=MB
BANK_ACCOUNT_NO=0900000001
BANK_ACCOUNT_NAME="AURA STUDIO"

